rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is admin
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        get(/databases/$(database)/documents/config/admin).data.allowlist.hasAny([request.auth.token.email]);
    }

    // Services: public read, admin write
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Recommendations subcollection: auth users write own doc, admins can write on behalf (approval flow)
      match /recommendations/{userId} {
        allow read: if true;
        allow create, update: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }
    }

    // Events: public callers can only read documents that the query proves are
    // published; admins retain full operational visibility.
    match /events/{eventId} {
      allow read: if isAdmin() || resource.data.publicationStatus == "published";
      allow create, update, delete: if isAdmin();

      // Interested subcollection: auth users write own doc
      match /interested/{userId} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Ingestion evidence, review candidates, and run ledgers are never public.
    match /eventSources/{sourceRecordId} {
      allow read, write: if isAdmin();

      match /revisions/{revisionId} {
        allow read, write: if isAdmin();
      }
    }

    match /eventCandidates/{candidateId} {
      allow read, write: if isAdmin();
    }

    // Per-approved-source health and unapproved discovery candidates are
    // operator-only. Ingestion jobs use Firebase Admin and bypass rules.
    match /eventSourceHealth/{sourceId} {
      allow read, write: if isAdmin();
    }

    match /sourceCandidates/{candidateId} {
      allow read, write: if isAdmin();
    }

    // Server ingestion claims these to make cross-source publication atomic.
    // Firebase Admin jobs bypass rules; browser operators need admin visibility.
    match /eventFingerprintRegistry/{fingerprint} {
      allow read, write: if isAdmin();
    }

    match /crawlRuns/{runId} {
      allow read, write: if isAdmin();

      match /sources/{sourceId} {
        allow read, write: if isAdmin();
      }
    }

    // Email identity, delivery history, webhook inbox, and abuse controls are
    // server-owned. Admin access is explicit; Firebase Admin jobs bypass rules.
    match /subscribers/{subscriberId} {
      allow read, write: if isAdmin();
    }

    match /digestEditions/{editionId} {
      allow read, write: if isAdmin();
    }

    match /digestDeliveries/{deliveryId} {
      allow read, write: if isAdmin();
    }

    // Bounded Friday invocations checkpoint only privacy-safe counters/cursors.
    match /digestRuns/{runId} {
      allow read, write: if isAdmin();
    }

    match /confirmationDeliveries/{deliveryId} {
      allow read, write: if isAdmin();
    }

    match /resendWebhookEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /rateLimits/{limitId} {
      allow read, write: if isAdmin();
    }

    // Lease mutation is exclusively a server concern; browser admins can use
    // the run/health ledgers without changing an active automation claim.
    match /automationLeases/{leaseId} {
      allow read, write: if false;
    }

    // Users: private, owner + admin read/write
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Subscriber linkage is server-owned. Clients may continue to maintain
      // their profile and preferences, but cannot smuggle linkage/status data
      // into a user document.
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          "displayName", "photoURL", "email", "joinedDate", "lastActive",
          "preferences", "preferenceSchemaVersion", "preferencesUpdatedAt"
        ]);
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName", "photoURL", "email", "joinedDate", "lastActive",
          "preferences", "preferenceSchemaVersion", "preferencesUpdatedAt"
        ]);
      allow delete: if isAdmin();

      match /savedEvents/{eventId} {
        allow read, create, update, delete: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }

      match /savedSearches/{searchId} {
        allow read, create, update, delete: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }
    }

    // Public profiles: public read, owner write
    match /public_profiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Suggested services: auth users create, owner read, admin full access
    match /suggested_services/{docId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Config: public read, admin write
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
