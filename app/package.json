    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.28.1",
    "jsdom": "^28.1.0",
