    "verify:pr": "npm run verify && npm run build",
    "ingest-events": "tsx scripts/ingest-events.ts",
    "backfill-event-identities": "tsx scripts/backfill-event-identities.ts",
    "normalize-legacy-events": "tsx scripts/normalize-legacy-events.ts"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "@vercel/analytics": "^1.6.1",
    "firebase": "^12.10.0",
    "fuse.js": "^7.1.0",
    "next": "^16.3.1",
    "node-ical": "^0.25.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
